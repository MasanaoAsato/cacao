# PostgreSQL
# POSTGRESQL_URL が空の場合は、POSTGRES_* の個別設定を使います。
POSTGRESQL_URL=
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=admin
POSTGRES_PASSWORD=Wt9wCKTIqjgv17ED
POSTGRES_DB=cacao
POSTGRES_SSLMODE=disable
POSTGRES_MAX_OPEN_CONNS=25
POSTGRES_MAX_IDLE_CONNS=5

# 旅程生成
LLM_DRIVER=stub
LLM_WEB_SEARCH=false
# LLM_DRIVER=openai のときだけ設定します。
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# LLM_DRIVER=openrouter のときだけ設定します。
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
OPENROUTER_REQUEST_TIMEOUT=60s

# LLM_DRIVER=ollama のときだけ設定します。Ollama は開発機で別途起動します。
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=
# 思考トークンを返すモデルでは false を推奨します。
OLLAMA_THINK=false
OLLAMA_REQUEST_TIMEOUT=180s

# LLM_WEB_SEARCH=true のときだけローカル SearXNG を使います。
SEARXNG_BASE_URL=http://127.0.0.1:8888
SEARXNG_REQUEST_TIMEOUT=10s
SEARXNG_RESULT_LIMIT=5
SEARXNG_PORT=8888
# .env でランダムな秘密値を設定します。Git へ実値を保存しません。
SEARXNG_SECRET=

# 旅程カバー画像生成
IMAGE_GENERATOR_DRIVER=stub
# IMAGE_GENERATOR_DRIVER=openrouter のときだけ設定します。OPENROUTER_API_KEY と共有します。
OPENROUTER_IMAGE_MODEL=
COMFYUI_BASE_URL=
COMFYUI_WORKFLOW_PATH=config/comfyui/journey_image_api.json
COMFYUI_MANIFEST_PATH=config/comfyui/journey_image_manifest.json
IMAGE_GENERATION_TIMEOUT=180s
# 旅程ごとの挿絵生成上限（1〜3）。表紙1枚は別に必ず生成します。
IMAGE_MAX_ILLUSTRATIONS=3
IMAGE_WORKER_CONCURRENCY=1
IMAGE_WORKER_POLL_INTERVAL=1s
IMAGE_WORKER_LEASE_DURATION=240s

# 画像ストレージ
IMAGE_STORAGE_DRIVER=filesystem
IMAGE_STORAGE_ROOT=./var/journey-images
IMAGE_MAX_BYTES=20971520
IMAGE_MAX_WIDTH=4096
IMAGE_MAX_HEIGHT=4096
IMAGE_MAX_PIXELS=16777216

# 旅のしおりPDF
# stub または gotenberg。既定値は stub です。
BOOKLET_PDF_DRIVER=stub
# gotenberg のときだけ必須です。コンテナから到達できるURLを指定してください。
BOOKLET_RENDER_BASE_URL=
BOOKLET_GOTENBERG_URL=
BOOKLET_PDF_TIMEOUT=30s
BOOKLET_PDF_CONCURRENCY=1
BOOKLET_PDF_MAX_BYTES=10485760
GOTENBERG_PORT=3002

